<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>IthuteSign.Modern</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250602001" />
    <ApplicationDefinition Include="App.xaml" />
    <Page Include="MainWindow.xaml" />
  </ItemGroup>
  <!-- A release must provide the tested x86 Wacom bridge and its SDK interop
       dependencies together. Missing release payload fails the build. -->
  <PropertyGroup>
    <WacomCapturePayload Condition="'$(WacomCapturePayload)' == ''">$(MSBuildProjectDirectory)\..\..\ithute-sign\wacom-bridge\bin</WacomCapturePayload>
  </PropertyGroup>
  <Target Name="BundleWacomCapture" AfterTargets="Build" Condition="'$(BundleWacomCapture)' == 'true'">
    <Error Condition="!Exists('$(WacomCapturePayload)\STUCapture.exe')" Text="Wacom capture payload missing: build and test the x86 bridge before packaging." />
    <ItemGroup>
      <WacomPayloadFiles Include="$(WacomCapturePayload)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(WacomPayloadFiles)" DestinationFiles="@(WacomPayloadFiles->'$(TargetDir)wacom-bridge\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
