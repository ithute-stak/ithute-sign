<Window
    x:Class="IthuteSign.Modern.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="IthuteSign">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView x:Name="Navigation" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False" OpenPaneLength="230" IsPaneOpen="True">
            <NavigationView.PaneHeader>
                <StackPanel Margin="8,12,8,20" Spacing="3">
                    <TextBlock Text="IthuteSign" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="DOCUMENT SIGNING" Opacity="0.65" FontSize="10" />
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Icon="Home" IsSelected="True" />
                <NavigationViewItem Content="Documents" Icon="Document" />
                <NavigationViewItem Content="Signing workspace" Icon="Edit" />
            </NavigationView.MenuItems>
            <ScrollViewer>
                <StackPanel Padding="40,30,40,40" Spacing="20" MaxWidth="1050" HorizontalAlignment="Left">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="14" Padding="20">
                        <StackPanel Spacing="10">
                            <TextBlock Text="LoanHub employee login" FontSize="20" FontWeight="SemiBold" />
                            <TextBox x:Name="LoanHubUrl" Header="LoanHub HTTPS address" Text="https://ithute.co.ls/" />
                            <TextBox x:Name="LoanHubPhone" Header="Phone number" />
                            <PasswordBox x:Name="LoanHubPassword" Header="Password" />
                            <PasswordBox x:Name="LoanHubOtp" Header="OTP (when required)" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Content="Log in to LoanHub" Click="LoanHubLogin_Click" />
                                <Button Content="Log out" Click="LoanHubLogout_Click" />
                            </StackPanel>
                            <Button Content="Open secure local Wacom workstation desk" Click="OpenLocalWorkstationDesk_Click" />
                            <TextBlock Text="The existing LoanHub Go connector must already be running on this computer at 127.0.0.1:8767. It manages its own authenticated session and enrolled device proof. IthuteSign does not pass login tokens or private keys to it." TextWrapping="Wrap" Opacity="0.7" />
                            <TextBox x:Name="WorkstationId" Header="Approved workstation ID (UUID)" PlaceholderText="Enter the registered LoanHub workstation ID" />
                            <Button Content="Check my workstation assignment" Click="CheckWorkstation_Click" />
                            <Button Content="Request device proof challenge" Click="RequestDeviceChallenge_Click" />
                            <TextBlock x:Name="DeviceChallengeStatus" Text="Device proof has not been requested. Signing disabled." TextWrapping="Wrap" />
                            <TextBlock x:Name="WorkstationStatus" Text="Workstation not verified. Signing disabled." TextWrapping="Wrap" />
                            <TextBlock x:Name="LoanHubLoginStatus" Text="Not connected. LoanHub signing is unavailable until authorized." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Welcome to IthuteSign" FontSize="32" FontWeight="SemiBold" />
                        <TextBlock Text="Your offline document signing workspace" Opacity="0.72" FontSize="15" />
                    </StackPanel>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="28">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Ready to sign a document?" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="Choose a PDF or Word document. The selected document opens directly in the tested signing application." TextWrapping="Wrap" Opacity="0.8" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Content="Choose document" Click="ChooseDocument_Click" />
                                <Button Content="Launch signing app" Click="LaunchLegacy_Click" />
                            </StackPanel>
                            <TextBlock x:Name="SelectedDocument" Text="No document selected" TextWrapping="Wrap" Opacity="0.7" />
                            <TextBlock x:Name="DocumentDetails" Text="Select a local document to view its details." TextWrapping="Wrap" Opacity="0.6" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="20">
                            <StackPanel Spacing="8"><TextBlock Text="Private by design" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="No cloud account or internet required for the signing workflow." TextWrapping="Wrap" /></StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="20">
                            <StackPanel Spacing="8"><TextBlock Text="Wacom STU-540" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Capture, clear, and accept signatures using the tested STU-540 bridge." TextWrapping="Wrap" /></StackPanel>
                        </Border>
                    </Grid>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="16">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="Document preview" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Content="Preview selected PDF" Click="PreviewSelected_Click" />
                            </StackPanel>
                            <TextBlock x:Name="PreviewHint" Text="Choose a PDF to preview locally. Word documents open in the signing engine." TextWrapping="Wrap" Opacity="0.7" />
                            <Border BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8">
                                <WebView2 x:Name="PdfPreview" Height="510" NavigationStarting="PdfPreview_NavigationStarting" />
                            </Border>
                            <TextBlock Text="Secure local preview. External windows and downloads are blocked. Signing still uses the verified application until the native workspace is completed." TextWrapping="Wrap" Opacity="0.65" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Recent documents (saved on this PC)" FontSize="20" FontWeight="SemiBold" />
                    <ListView x:Name="RecentFiles" Height="170" SelectionMode="Single" SelectionChanged="RecentFiles_SelectionChanged" />
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="Appearance" VerticalAlignment="Center" />
                        <ComboBox x:Name="ThemeSelector" SelectedIndex="0" SelectionChanged="ThemeSelector_SelectionChanged" Width="150">
                            <ComboBoxItem Content="System"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/>
                        </ComboBox>
                    </StackPanel>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="14" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Signing engine" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Optional: set the full path to the tested IthuteSign.exe. Leave blank for automatic discovery." TextWrapping="Wrap" Opacity="0.7" />
                            <TextBox x:Name="SignerPath" PlaceholderText="C:\Program Files\IthuteSign\IthuteSign.exe" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Content="Save signing engine path" Click="SaveSignerPath_Click" />
                                <Button Content="Forget recent documents" Click="ClearRecent_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <InfoBar x:Name="StatusBar" IsOpen="False" Severity="Informational" IsClosable="True" />
                </StackPanel>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
